# ============================================================
# JARVIS — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_KEY
API_KEY=CHANGE_ME_GENERATE_A_REAL_KEY
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./jarvis.db

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- STT (Speech-to-Text) ---
STT_PROVIDER=faster_whisper
STT_MODEL=tiny
STT_LANGUAGE=en
STT_DEVICE=cpu

# --- AI / Intent Engine ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# --- TTS (Text-to-Speech) ---
TTS_PROVIDER=piper
PIPER_MODEL_PATH=./models/piper/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=./models/piper/en_US-lessac-medium.onnx.json
TTS_SAMPLE_RATE=22050

# --- Spotify ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_POLL_INTERVAL=5

# --- ESP32 ---
ESP32_API_KEY=CHANGE_ME_GENERATE_A_REAL_KEY
MAIN_ESP32_ID=main_esp32_01

# --- Voice ---
VAD_AGGRESSIVENESS=2
SILENCE_TIMEOUT_MS=1500
MAX_RECORDING_SECONDS=15
AUDIO_PRIVACY_MODE=true

# --- Automation ---
AUTOMATION_COOLDOWN_SECONDS=30
MAX_AUTOMATION_CHAIN_DEPTH=3

# --- Firmware ---
FIRMWARE_DIR=./firmware-build

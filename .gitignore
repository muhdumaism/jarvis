# ============================================================
# NILA .gitignore
# ============================================================

# --- Environment ---
.env
server/.env
*.env.local

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# --- Database ---
*.db
*.db-journal
*.db-wal
*.db-shm
backups/

# --- Node ---
node_modules/
dashboard/dist/
dashboard/build/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Firmware builds ---
firmware-build/*.bin
firmware-build/*.elf
firmware-build/*.map

# --- Models (large files) ---
models/
*.onnx
*.onnx.json
*.pt
*.bin

# --- Logs ---
logs/
*.log

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
